{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],

    "outDir": "./dist",
    "rootDir": ".",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./src/generated/prisma"]
    },

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}